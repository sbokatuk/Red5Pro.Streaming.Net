<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MAUI sample that publishes and subscribes through Red5 Cloud or a standalone Red5 Pro server.

    Consumes the packed Red5Pro.Streaming.Net.Maui package from artifacts/ (see NuGet.config), so it
    exercises the packages exactly as a consumer would rather than through project references.

    Target frameworks follow the SDK band, like the binding projects: no single .NET SDK can build
    net8, net9 and net10 for a platform. Build the other band with -p:Red5SdkBand=net10 from a
    directory whose global.json selects the .NET 10 SDK.

    Android and iOS only. Red5 publish no Mac Catalyst slice for Red5WebRTCKit, and there is no
    Windows or Tizen SDK at all, so those legs of the MAUI template are removed rather than left to
    fail at link time.
  -->
  <PropertyGroup>
    <TargetFrameworks>$(Red5AndroidTargetFrameworks);$(Red5IosTargetFrameworks)</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>Red5Pro.Streaming.Net.Sample</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <ApplicationTitle>Red5 Sample</ApplicationTitle>
    <ApplicationId>net.red5.streaming.sample</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">$(Red5AndroidMinSdk).0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">$(Red5IosMinVersion)</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1B1F26" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1B1F26" BaseSize="128,128" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <!--
      Defaults to the version in Directory.Build.props so a plain build after BuildNugets.sh works;
      override with -p:Red5PackageVersion=... to test a specific build.
    -->
    <Red5PackageVersion Condition=" '$(Red5PackageVersion)' == '' ">$(Red5Version)</Red5PackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />

    <!--
      Red5Pro.Streaming.Net.Maui brings Red5Pro.Streaming.Net with it, which in turn brings the
      platform binding matching whichever target framework is being built. One reference covers it.

      Exact version, in brackets. A bare version is a *minimum* to NuGet, so when the requested build
      is missing from artifacts/ it is silently satisfied from nuget.org instead - which means the
      sample can appear to build against local changes while actually compiling against a published
      release. Pinning turns that into an unambiguous restore error.
    -->
    <PackageReference Include="Red5Pro.Streaming.Net.Maui" Version="[$(Red5PackageVersion)]" />
  </ItemGroup>

  <!--
    The licence keys and endpoints come from Directory.Build.local.props or the environment - see
    the repository README. They are baked in as constants so the sample can be launched without
    typing them, which matters on a phone; a real app would not do this.
  -->
  <ItemGroup>
    <AssemblyMetadata Include="Red5CloudEndpoint" Value="$(Red5CloudEndpoint)" />
    <AssemblyMetadata Include="Red5CloudLicenseKey" Value="$(Red5CloudLicenseKey)" />
    <AssemblyMetadata Include="Red5ProEndpoint" Value="$(Red5ProEndpoint)" />
    <AssemblyMetadata Include="Red5ProLicenseKey" Value="$(Red5ProLicenseKey)" />
  </ItemGroup>

</Project>
