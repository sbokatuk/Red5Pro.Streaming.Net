<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MAUI conveniences over Red5Pro.Streaming.Net: the video view and its handlers, plus the
    platform glue a MAUI app would otherwise write by hand (the Android Activity, and pulling the
    native view out of a handler).

    Separate from Red5Pro.Streaming.Net on purpose. Everything here needs Microsoft.Maui.Controls,
    and forcing that on a plain .NET for Android or .NET for iOS consumer to get a WebRTC client
    would be a poor trade.
  -->
  <PropertyGroup>
    <TargetFrameworks>$(Red5AndroidTargetFrameworks);$(Red5IosTargetFrameworks)</TargetFrameworks>

    <AssemblyName>Red5Pro.Streaming.Net.Maui</AssemblyName>
    <RootNamespace>Red5Pro.Streaming.Net.Maui</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">$(Red5AndroidMinSdk)</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">$(Red5IosMinVersion)</SupportedOSPlatformVersion>

    <!--
      UseMauiCore rather than UseMaui: this is a library of handlers and extensions, not an app,
      and the full UseMaui brings in app-only targets (resource generation, splash screens) that
      have nothing to do here.
    -->
    <UseMauiCore>true</UseMauiCore>
    <UseMauiEssentials>true</UseMauiEssentials>
    <SingleProject>true</SingleProject>
  </PropertyGroup>

  <PropertyGroup>
    <Red5DependencyVersion Condition=" '$(Red5DependencyVersion)' == '' ">$(Version)</Red5DependencyVersion>
  </PropertyGroup>

  <!-- Platform code is selected per target framework rather than by the default glob. -->
  <ItemGroup>
    <Compile Remove="Platforms/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <Compile Include="Platforms/Android/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <Compile Include="Platforms/iOS/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Red5Pro.Streaming.Net" Version="[$(Red5DependencyVersion)]" />
  </ItemGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Red5Pro.Streaming.Net.Maui</PackageId>
    <Title>.NET MAUI video view and helpers for Red5Pro.Streaming.Net.</Title>
    <Description>Adds a Red5VideoView control and the platform glue a .NET MAUI app needs to use Red5Pro.Streaming.Net: rendering into a native WebRTC surface, and supplying the Android Activity the SDK requires. Add Red5Pro.Streaming.Net on its own if you are not using MAUI.</Description>
    <PackageTags>Red5;Red5Pro;Red5Cloud;WebRTC;streaming;SDK;MAUI;Android;iOS;video</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../assets/icon.png" Pack="true" PackagePath="/" Visible="false" />
    <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
